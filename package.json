{
  "name": "elysia-local-model",
  "version": "0.1.0",
  "description": "An Elysia plugin for local in-app Hugging Face transformer models.",
  "license": "MIT",
  "repository": "https://github.com/Aft1n/elysia-local-model",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json --emitDeclarationOnly --outDir dist && bun build ./src/index.ts --outdir dist --target node --packages external",
    "lint": "oxlint .",
    "test": "bun test",
    "test:types": "tsc --noEmit",
    "prepack": "bun run build",
    "release": "npm run release:preflight && npm run lint && npm run test && npm run test:types && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "release:preflight": "npm whoami --registry https://registry.npmjs.org/ > /dev/null",
    "release:verify": "npm publish --dry-run",
    "prepublishOnly": "npm run release:preflight"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "onnxruntime-node": "^1.24.3"
  },
  "peerDependencies": {
    "@huggingface/tokenizers": ">=0.2.0",
    "elysia": ">=2.0.0-beta.0"
  },
  "peerDependenciesMeta": {
    "@huggingface/tokenizers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.4",
    "changelogen": "^0.6.2",
    "elysia": "2.0.0-beta.31",
    "oxlint": "^1.57.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "trustedDependencies": [
    "onnxruntime-node",
    "protobufjs"
  ]
}
